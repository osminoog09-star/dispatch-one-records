# ===== Секреты =====
.env
*.env
# конфиги агента содержат ключ доступа — в публичный репозиторий не кладём
agent/sync-config.ini
agent/dist/sync-config.ini
installer/sync-config.ini
!agent/sync-config.example.ini
# ключ, вшиваемый в установщик при сборке — в репозиторий не попадает
installer/embedded_token.py

# База данных ХРАНИТСЯ в репозитории — из неё GitHub Actions пересобирает сайт 24/7.
# (server/data.db намеренно НЕ игнорируется)
server/screenshots/*
!server/screenshots/.gitkeep

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
server/.venv/
*.egg-info/

# ===== .NET (карьерный мод / клиент) =====
bin/
obj/
clients/**/bin/
clients/**/obj/
clients/**/_stub/out/
clients/**/_stub/obj/
clients/**/_stub/bin/
# Чужие игровые DLL не коммитим (лицензии — см. docs/LEGAL-IP.md)
clients/**/libs/*.dll
clients/**/libs/*.exe

# ===== Сборка агента (exe раздаётся отдельно, не через git) =====
agent/build/
agent/dist/*.exe
agent/dist/_test_out.txt
*.spec

# ===== Туннель (бинарь качается отдельно) =====
host/*.exe

# ===== Скретч/временное =====
vinewood-study/
*.log

# ===== IDE / ОС =====
.vs/
.idea/
.vscode/
Thumbs.db
Desktop.ini
launcher/embedded_token.py
launcher/pdcomp_sync.exe
gateway/.dev.vars
launcher/gateway_config.py
